<top>
    <HBox fx:id="navHbox" prefHeight="50.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
        <children>

            <!-- ── Sidebar toggle button ── -->
            <Button fx:id="sidebarToggleBtn" mnemonicParsing="false" onAction="#toggleSidebar" prefHeight="47.0" prefWidth="52.0" styleClass="sidebar-toggle-btn">
                <graphic>
                    <StackPane>
                        <children>

                            <!-- Close icon — visible when sidebar is CLOSED -->
                            <ImageView fx:id="menuCloseIcon" fitHeight="22.0" fitWidth="101.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../Images/close.png" />
                                </image>
                            </ImageView>

                            <!-- Hamburger icon — visible when sidebar is OPEN -->
                            <ImageView fx:id="menuOpenIcon" fitHeight="22.0" fitWidth="22.0" layoutX="10.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" visible="false">
                                <image>
                                    <Image url="@../Images/side-menu.png" />
                                </image>
                            </ImageView>

                        </children>
                    </StackPane>
                </graphic>
                <padding>
                    <Insets left="10.0" right="6.0" />
                </padding>
            </Button>

            <!-- ── App title ── -->
            <TextField fx:id="appTitle" editable="false" prefHeight="31.0" prefWidth="182.0" styleClass="selectable-title" text="CourseVault" />

            <!-- ── Spacer — pushes nav to the right ── -->
            <Region prefHeight="50.0" prefWidth="1.0" HBox.hgrow="ALWAYS" />

            <!-- ── Nav buttons + sliding indicator ── -->
            <AnchorPane prefHeight="50.0" prefWidth="560.0">
                <children>

                    <!-- Sliding underline indicator -->
                    <Rectangle fx:id="navIndicator" arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="4.0" layoutY="44.0" stroke="BLACK" strokeType="INSIDE" styleClass="navIndicator" width="60.0" />

                    <!-- Nav button row -->
                    <HBox fx:id="navBar" prefHeight="34.0" prefWidth="560.0">
                        <children>
                        <Button fx:id="homeButton" mnemonicParsing="false" prefHeight="34.0" prefWidth="135.0" text="Home">
                           <styleClass>
                              <String fx:value="nav-button" />
                              <String fx:value="nav-border-both" />
                           </styleClass>
                        </Button>

                            <Button fx:id="courseButton" mnemonicParsing="false" prefHeight="34.0" prefWidth="135.0" text="Courses">
                                <styleClass>
                                    <String fx:value="nav-button" />
                                    <String fx:value="nav-border-both" />
                                </styleClass>
                            </Button>

                            <Button fx:id="myCourseButton" mnemonicParsing="false" prefHeight="34.0" prefWidth="135.0" text="My Course">
                                <styleClass>
                                    <String fx:value="nav-button" />
                                    <String fx:value="nav-border-both" />
                                </styleClass>
                            </Button>

                            <Button fx:id="browseButton" mnemonicParsing="false" prefHeight="34.0" prefWidth="135.0" text="Browse">
                                <styleClass>
                                    <String fx:value="nav-button" />
                                    <String fx:value="nav-border-both" />
                                </styleClass>
                            </Button>
                        <Button fx:id="themeToggleBtn" mnemonicParsing="false" onAction="#toggleTheme" prefHeight="36.0" prefWidth="65.0" styleClass="nav-button" stylesheets="@../CSS/scene1.css" text="☀" />

                        </children>
                    </HBox>

                </children>
            </AnchorPane>

        </children>
    </HBox>
</top>

<left>
    <!-- ✅ fx:id is on the OUTER AnchorPane directly — this is what gets toggled -->
    <!-- ✅ minWidth="0" allows the collapse animation to go all the way to 0 -->
    <AnchorPane fx:id="sidebarPane" minHeight="0.0" minWidth="0.0" prefHeight="1050.0" prefWidth="231.0" BorderPane.alignment="CENTER">
        <children>

            <!-- Dashboard label -->
            <Label layoutX="25.0" layoutY="30.0" styleClass="sidebar-title" text="Dashboard" />

            <!-- Sidebar buttons container -->
            <VBox fx:id="sidebarContainer" layoutX="10.0" layoutY="70.0" prefHeight="151.0" prefWidth="220.0" spacing="12" style="-fx-background-color: transparent;                          -fx-padding: 0;">
                <children>
                    <!-- Sliding indicator rectangle -->
                    <Rectangle fx:id="sidebarIndicator" fill="#1e293b" height="3.0" stroke="TRANSPARENT" strokeType="INSIDE" styleClass="sidebarIndicator" width="220.0" />

                    <Button fx:id="departmentMenuTrigger" mnemonicParsing="false" styleClass="sidebar-trigger-btn" text="Browse Year" />
                </children>
            </VBox>

        </children>
    </AnchorPane>
</left>
   <bottom>
      <VBox fx:id="footerRoot" alignment="CENTER" prefHeight="80.0" prefWidth="812.0" styleClass="footer-root" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="8.0" prefWidth="812.0" spacing="32.0" styleClass="footer-body">
               <children>
                  <VBox prefHeight="78.0" prefWidth="423.0" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="footer-logo" text="CourseVault" />
                        <Label styleClass="footer-brand-desc" text="A centralized learning platform for university students to access course materials, exams and resources." wrapText="true" />
                     </children>
                  </VBox>
                  <Separator orientation="VERTICAL" prefHeight="200.0" styleClass="footer-divider" />
                  <VBox prefHeight="83.0" prefWidth="100.0" spacing="10.0">
                     <children>
                        <Label styleClass="footer-col-title" text="App" />
                        <Hyperlink fx:id="aboutLink" onAction="#openAbout" styleClass="footer-link" text="About" />
                        <Hyperlink fx:id="githubLink" onAction="#openGithub" styleClass="footer-link" text="GitHub" />
                        <Hyperlink fx:id="reportLink" onAction="#openReport" styleClass="footer-link" text="Report Bug" />
                     </children>
                  </VBox>
                  <Separator orientation="VERTICAL" prefHeight="200.0" styleClass="footer-divider" />
                  <VBox prefHeight="80.0" prefWidth="100.0" spacing="10.0">
                     <children>
                        <Label styleClass="footer-col-title" text="Links" />
                        <Hyperlink fx:id="websiteLink" onAction="#openWebsite" styleClass="footer-link" text="Website" />
                        <Hyperlink fx:id="contactLink" onAction="#openContact" styleClass="footer-link" text="Contact" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="8.0" left="18.0" right="18.0" top="10.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="footer-bottom">
               <children>
                  <Label styleClass="footer-copy" text="© 2026 CourseVault. All rights reserved." HBox.hgrow="ALWAYS" />
                  <Label styleClass="footer-version" text="v1.0.0" />
               </children>
               <padding>
                  <Insets bottom="4.0" left="18.0" right="18.0" top="4.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
